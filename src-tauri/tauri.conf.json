{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrowserHub",
  "version": "0.1.1",
  "identifier": "space.forga.browserhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BrowserHub",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "BrowserHub",
    "copyright": "Copyright © 2026 BrowserHub",
    "category": "Utility",
    "shortDescription": "Chrome 浏览器环境管理器",
    "longDescription": "BrowserHub 是一个本地优先的 Chrome 多环境管理器。每个环境使用独立的 User Data Directory，登录状态、扩展和浏览数据互不影响。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
